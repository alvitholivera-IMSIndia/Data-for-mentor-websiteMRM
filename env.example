SECRET_KEY=change-me-to-a-long-random-string
# Postgres (Neon / Supabase / Vercel Postgres). Leave empty locally -> SQLite file is used.
DATABASE_URL=
# First admin, created automatically when the users table is empty
ADMIN_EMAIL=you@ims.com
ADMIN_PASSWORD=change-me
# Optional: direct Google Sheet sync (share the sheet with the service account email as Viewer)
GSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: protects /api/cron-sync (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
